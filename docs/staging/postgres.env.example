# PRICE SENTINEL V2 STAGING ONLY — no production database data.
# Copy to /etc/price-sentinel-v2/postgres.env on approved staging host.
# Must use the EXACT same NEW password in backend.env DATABASE_URL.
POSTGRES_USER=ps_v2_app
POSTGRES_DB=price_sentinel_v2_staging
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD
