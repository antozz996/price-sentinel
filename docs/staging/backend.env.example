# PRICE SENTINEL V2 STAGING ONLY — example, NEVER use production secrets.
# Copy to /etc/price-sentinel-v2/backend.env on the approved staging host.
# Permissions: chmod 0600. Values MUST be independently generated.
# No V2 service should be exposed until staging access controls are validated.
ENVIRONMENT=staging
DEBUG=false
AUTOMATION_ENABLED=false
DATABASE_URL=postgresql+asyncpg://ps_v2_app:REPLACE_WITH_UNIQUE_RANDOM_PASSWORD@db:5432/price_sentinel_v2_staging
SECRET_KEY=REPLACE_WITH_DIFFERENT_RANDOM_64_CHAR_JWT_SECRET
ARUBA_WEBHOOK_API_KEY=REPLACE_WITH_DIFFERENT_RANDOM_STAGING_WEBHOOK_KEY
LIQUIDSTOCK_INTEGRATION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_CHAR_DISABLED_BRIDGE_SECRET
# Intentionally no real Aruba webhook, production API, supplier integration or Google keys.
