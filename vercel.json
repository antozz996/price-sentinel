{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/fornitore/listino/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/god",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
