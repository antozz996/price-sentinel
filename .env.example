# ─────────────────────────────────────────────
# PRICE SENTINEL — Environment Variables
# Provisionare fuori dal repository in /etc/price-sentinel/*.env (0600)
# ─────────────────────────────────────────────

# ── Database applicativo ────────────────────
DATABASE_URL=postgresql+asyncpg://APP_ROLE:APP_PASSWORD@db:5432/APP_DATABASE

# ── FastAPI / Auth ──────────────────────────
SECRET_KEY=REQUIRED_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Aruba Webhook ───────────────────────────
ARUBA_WEBHOOK_API_KEY=REQUIRED_PROVIDER_SECRET

# ── LiquidStock integration ─────────────────
# Usa un valore casuale diverso per ogni ambiente; non inserirlo nel frontend.
LIQUIDSTOCK_INTEGRATION_SECRET=REQUIRED_SHARED_HMAC_SECRET
# Opzionale, solo durante una finestra controllata di rotazione.
LIQUIDSTOCK_INTEGRATION_PREVIOUS_SECRET=
INTEGRATION_MAX_CLOCK_SKEW_SECONDS=300

# ── Notifiche (Sprint 3) ───────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Ambiente ────────────────────────────────
ENVIRONMENT=development
DEBUG=true
